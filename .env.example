# =============================================================================
# FPP — Variables d'environnement (template)
# Copier ce fichier vers .env et adapter les valeurs
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api-fpp.monajent.com

# --- PostgreSQL ---
POSTGRES_DB=fpp_db
POSTGRES_USER=fpp_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Media ---
MEDIA_ROOT=/app/media

# --- Email ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@fpp.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@fpp.com

# --- Frontend (build-time Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SITE_NAME=FPP - Front Patriotique Panafricain
