# =============================================================================
# FPP — Variables d'environnement (template)
# Copier ce fichier vers .env et adapter les valeurs
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.fpp-ci.online

# --- PostgreSQL ---
POSTGRES_DB=fpp_db
POSTGRES_USER=fpp_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Media ---
MEDIA_ROOT=/app/media

# --- Matricule HMAC ---
MATRICULE_SECRET_KEY=change-me-in-production

# --- Email (Hostinger SMTP — SSL port 465) ---
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@fpp-ci.online
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=info@fpp-ci.online
SERVER_EMAIL=info@fpp-ci.online

# --- Procédure d'urgence (5-6 emails séparés par des virgules) ---
EMERGENCY_EMAILS=admin1@fpp-ci.online,admin2@fpp-ci.online

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SITE_NAME=FPP - Front Patriotique Panafricain
